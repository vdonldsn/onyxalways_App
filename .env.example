# OnyxAlways environment variables
# Copy this file to `.env` for local development.
# In production (Railway, Fly.io, etc.) set these in the platform's UI instead.

# Database URL.
# - For local development with SQLite (no setup):
#     DATABASE_URL=sqlite:///./onyxalways.db
#
# - For Supabase (production-recommended):
#     Get from Supabase dashboard → Project Settings → Database → Connection string → URI
#     IMPORTANT: Use the "Session pooler" or "Transaction pooler" string (port 6543 or 5432
#     via pooler host), NOT the direct connection — pooler scales better and works
#     reliably from serverless platforms.
#     Replace [YOUR-PASSWORD] with your actual database password.
#     DATABASE_URL=postgresql://postgres.PROJECTREF:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres
#
# - For Railway Postgres:
#     Railway auto-injects DATABASE_URL when you add a Postgres plugin — nothing to do.

DATABASE_URL=sqlite:///./onyxalways.db
